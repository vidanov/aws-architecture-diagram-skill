<mxfile host="app.diagrams.net" agent="test">
  <diagram id="bad-test" name="Bad Example">
    <mxGraphModel dx="1200" dy="800" grid="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="vpc1" value="VPC" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="peering_bad" value="VPC Peering" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.vpc_peering;strokeColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="floating_edge" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="250" as="sourcePoint" />
            <mxPoint x="600" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="half_edge" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" source="vpc1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="700" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
